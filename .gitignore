# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
*.pyc

# Virtual environments
.venv/
venv/
env/

# Data (regenerated by scripts; datasets may be large or contain private URLs)
data/raw/*
data/interim/*
data/processed/*
data/splits/*
data/manifests/*
data/external/*
data/integrated/*
data/feedback/*
data/quarantine/*
data/LegitPhish Dataset/*
data/Phishing Detection Dataset/*
data/Phishing URL dataset/*
!data/manifests/.gitkeep
!data/splits/.gitkeep
!data/splits/README.md

# Models and experiment artifacts
models/versions/*
experiments/results/*
experiments/configurations/*

# Reports generated artifacts
reports/figures/*
reports/tables/*
!reports/figures/.gitkeep

# Database (local SQLite, regenerated)
database/*.db
database/*.sqlite

# Secrets
.env
.env.local

# Jupyter
.ipynb_checkpoints/

# Logs
logs/*
