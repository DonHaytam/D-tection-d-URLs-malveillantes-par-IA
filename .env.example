# Phishing AI Master 2 - environment configuration (copy to .env)
# Never commit .env with real secrets.
#
# Application environment: development | testing | production
APP_ENV=development

# Deployed model (do not change without validation)
MODEL_PATH=D:/openhands/projects/v2/phishing_ai_master/models/versions/M1_LR_HARDNEG.joblib
META_PATH=D:/openhands/projects/v2/phishing_ai_master/models/versions/metadata.json

# A/B testing
AB_TEST_ENABLED=1
AB_TEST_SPLIT=0.5

# CORS allowlist (comma-separated). Use your frontend origin in production.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# Admin API key for protected endpoints (/retraining/*). Leave empty for local dev mode.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
